{
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/node_modules/**": true,
    "**/.git/objects/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/coverage/**": true,
    "**/.turbo/**": true
  },

  "files.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/dist": true,
    "**/build": true
  },

  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/.git": true,
    "**/dist": true,
    "**/build": true,
    "**/coverage": true,
    "**/.turbo": true
  },

  // Tailwind CSS
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.validate": true,

  // ESLint
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  // Format on save
  "editor.formatOnSave": true,

  // Material Icon Theme
  "workbench.iconTheme": "material-icon-theme"
}
